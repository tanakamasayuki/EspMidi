# Profile-specific serial ports.
# These names match sketch.yaml profile names uppercased by pytest-embedded.

# Single ESP32-S3 used by loopback/ (UART MIDI with no wiring: UART1_TX and
# UART2_RX are routed to the same GPIO through the GPIO matrix).
TEST_SERIAL_PORT_S3_LOOPBACK=/dev/ttyACM0

# Single ESP32-P4 used by loopback/ when USB Host and USB Device run on the
# same board. Not assumed to be connected all the time.
TEST_SERIAL_PORT_P4_LOOPBACK=/dev/ttyACM1

# Always-connected ESP32-S3 peer pair, shared with the sibling projects.
# HOST is the board running the USB Host side.
# DEVICE is the board running the USB Device side.
# For peer/uart_midi the same wiring is reused as a crossover: the host role
# drives TX on GPIO19 / RX on GPIO20 and the device role does the opposite.
TEST_SERIAL_PORT_S3_PEER_HOST=/dev/ttyUSB0
TEST_SERIAL_PORT_PEER_DEVICE_S3_PEER_DEVICE=/dev/ttyUSB1

# Optional board for running arduino_smoke/ and manual/ on real hardware.
TEST_SERIAL_PORT_ESP32S3=/dev/ttyACM2

# pytest options to generate an HTML report.
#PYTEST_ADDOPTS="--html=report.html --self-contained-html"
